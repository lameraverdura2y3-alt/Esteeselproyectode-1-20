using System;
using System.Linq;

namespace Pràctica_3;

public static class Program
{
    public static void Main()
    {
        // Turnos Pares e Impares en el Control de Lotes de Quinua
        const int TOTAL_LOTES = 4;

        int contadorPares = 0;
        int contadorImpares = 0;
        int numero = 1;

        while (numero <= TOTAL_LOTES)
        {
            if (numero % 2 == 0)
            {
                Console.WriteLine("Lote " + numero + ": turno MANANA (par)");
                contadorPares++;
            }
            else
            {
                Console.WriteLine("Lote " + numero + ": turno TARDE (impar)");
                contadorImpares++;
            }

            numero++;
        }

        Console.WriteLine("Lotes en turno manana (pares): " + contadorPares);
        Console.WriteLine("Lotes en turno tarde (impares): " + contadorImpares);
    }
}

